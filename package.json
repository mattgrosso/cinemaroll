{
  "name": "cinema-roll",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "update-version": "node src/assets/javascript/version.js",
    "serve": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "predeploy": "node scripts/backup-database.mjs --quiet --skip-if-fresh=6 || echo backup-skipped",
    "deploy": "node scripts/bump-and-build.mjs && aws s3 sync dist/ s3://cinemaroll --delete --profile personal-deploy && aws cloudfront create-invalidation --distribution-id ETF4I2E64GQSC --paths '/*' --profile personal-deploy > invalidation_output.txt",
    "account-maintenance": "node scripts/account-maintenance.mjs",
    "backup-db": "node scripts/backup-database.mjs",
    "restore-db": "node scripts/restore-database.mjs",
    "mint-test-token": "node scripts/mint-test-token.mjs",
    "fetch-bug-reports": "node scripts/fetch-bug-reports.mjs",
    "delta-shadow-report": "node scripts/delta-shadow-report.mjs",
    "resolve-bug-report": "node scripts/resolve-bug-report.mjs",
    "purge-qa-social": "node scripts/purge-qa-social.mjs",
    "link-qa-tester": "node scripts/link-qa-tester.mjs",
    "diverge-test-library": "node scripts/diverge-test-library.mjs",
    "link-tester-hat": "node scripts/link-tester-hat.mjs",
    "generate-db-rules": "node scripts/generate-database-rules.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/multimonth": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@fullcalendar/vue3": "^6.1.15",
    "@popperjs/core": "^2.11.8",
    "@sentry/tracing": "^7.114.0",
    "@sentry/vue": "^7.36.0",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.7",
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "dotenv": "^16.4.7",
    "firebase": "^9.17.1",
    "fuse.js": "^7.4.2",
    "lodash": "^4.17.21",
    "ordinal-js": "^1.1.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.13",
    "vue-chart-3": "^3.1.8",
    "vue-router": "^4.5.0",
    "vue3-click-away": "^1.2.4",
    "vue3-lazyload": "^0.3.8",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "1.6.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^10",
    "eslint-plugin-promise": "^7",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^13",
    "globals": "^15",
    "jsdom": "^26.1.0",
    "sass": "^1.83.0",
    "vite": "5.4.21",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "1.6.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
